{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/classic", "destination": "/classic/", "permanent": true },
    { "source": "/explore", "destination": "/explore/", "permanent": true },
    { "source": "/docs", "destination": "/docs/", "permanent": true },
    { "source": "/neo/docs.html", "destination": "/docs/", "permanent": true },
    { "source": "/neo/:path*", "destination": "/explore/", "permanent": true },
    { "source": "/neo", "destination": "/explore/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://rest.ensembl.org; img-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
